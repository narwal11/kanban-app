# Frontend (Vite). Copy to .env and fill in.
# Supabase project URL and anon/publishable key (used for sign-in only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-supabase-anon-key

# Base URL of the Express API (also used for the Socket.io connection).
VITE_API_URL=http://localhost:3001
